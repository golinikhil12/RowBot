# RowBot Backend Configuration
# Copy this file to .env and fill in real values

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_PORT=5000

# File upload limits (MB)
MAX_FILE_SIZE_MB=55

# Supabase (optional – app works without these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: OpenAI or Gemini API key for advanced NLP copilot
# Leave blank to use deterministic rule-based copilot only
OPENAI_API_KEY=
GEMINI_API_KEY=

# Temporary file cleanup (minutes)
JOB_TTL_MINUTES=60
